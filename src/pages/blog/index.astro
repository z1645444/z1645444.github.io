---
import { withBase } from '../../consts';

const homeUrl = withBase();
---
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta http-equiv="refresh" content={`0;url=${homeUrl}`} />
	<script is:inline define:vars={{ homeUrl }}>
		window.location.replace(homeUrl);
	</script>
</head>
<body>
	<p>正在跳转到首页...</p>
</body>
</html>
