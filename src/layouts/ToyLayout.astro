---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import QuadrantIcon from '../components/QuadrantIcon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, QUADRANTS_CONFIG } from '../consts';

interface Props {
	title?: string;
	description?: string;
	activeCategory?: string; // id of active quadrant: 'build' | 'explore' | 'observe' | 'about'
}

const { 
	title = SITE_TITLE, 
	description = SITE_DESCRIPTION, 
	activeCategory = '' 
} = Astro.props;

// Find active quadrant configuration
const activeQuad = QUADRANTS_CONFIG.quadrants.find(q => q.id === activeCategory);
const accentColorLight = activeQuad ? activeQuad.colorLight : '#3A828A';
const accentColorDark = activeQuad ? activeQuad.colorDark : '#4C9F9B';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<!-- Dynamically override accent color variables based on category and theme -->
		<style define:vars={{ accentColorLight, accentColorDark }}>
			:root {
				--accent: var(--accentColorLight);
			}
			:root[data-theme="dark"] {
				--accent: var(--accentColorDark);
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--accent: var(--accentColorDark);
				}
			}
		</style>
		<style>
			/* Layout styling */
			.app-container {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				background-color: var(--bg-page);
				transition: background-color 0.2s ease-in-out;
			}

			/* Sticky Top Navigation Bar (reusing sidebar class) */
			.sidebar {
				width: 100%;
				height: auto;
				background-color: var(--bg-sidebar);
				border-bottom: 2px solid var(--border-color);
				padding: 1.2rem 3rem;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				position: sticky;
				top: 0;
				z-index: 100;
				transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out;
			}

			.sidebar-top {
				display: flex;
				flex-direction: row;
				align-items: center;
				gap: 3rem;
				flex: 1;
			}

			.logo {
				font-family: var(--font-atkinson);
				font-size: 2.2rem;
				font-weight: 900;
				letter-spacing: -1px;
				color: var(--text-main);
				text-decoration: none;
				display: inline-block;
				transition: transform 0.2s ease;
			}
			.logo:hover {
				transform: rotate(-2deg) scale(1.03);
			}

			.logo-dot {
				color: var(--accent);
				transition: color 0.3s ease;
			}

			/* Horizontal Navigation List */
			.nav-list {
				display: flex;
				flex-direction: row;
				gap: 0.8rem;
				list-style: none;
				padding: 0;
			}

			.nav-item-link {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.6rem 1.2rem;
				font-weight: 700;
				font-size: 1.05rem;
				color: var(--text-main);
				text-decoration: none;
				border: 2px solid transparent;
				border-radius: 16px;
				transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}

			/* Inactive Link Default Hover Base (Raises up) */
			.nav-item-link:hover {
				border-color: var(--border-color);
				transform: translate(-2px, -2px);
				box-shadow: 3px 3px 0 var(--shadow-flat);
			}

			/* Category-specific Hover Colors (Static CSS to prevent View Transition morphing bugs) */
			
			/* Build (Teal) */
			.nav-item-link[data-category="build"]:hover {
				background-color: color-mix(in srgb, #3A828A 12%, transparent);
				color: #3A828A;
			}
			.nav-item-link[data-category="build"]:hover .icon-wrapper {
				border-color: #3A828A;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="build"]:hover {
				background-color: color-mix(in srgb, #4C9F9B 18%, transparent);
				color: #4C9F9B;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="build"]:hover .icon-wrapper {
				border-color: #4C9F9B;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="build"]:hover {
					background-color: color-mix(in srgb, #4C9F9B 18%, transparent);
					color: #4C9F9B;
				}
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="build"]:hover .icon-wrapper {
					border-color: #4C9F9B;
				}
			}

			/* Explore (Olive Green) */
			.nav-item-link[data-category="explore"]:hover {
				background-color: color-mix(in srgb, #8B9E31 12%, transparent);
				color: #8B9E31;
			}
			.nav-item-link[data-category="explore"]:hover .icon-wrapper {
				border-color: #8B9E31;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="explore"]:hover {
				background-color: color-mix(in srgb, #9CAF3F 18%, transparent);
				color: #9CAF3F;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="explore"]:hover .icon-wrapper {
				border-color: #9CAF3F;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="explore"]:hover {
					background-color: color-mix(in srgb, #9CAF3F 18%, transparent);
					color: #9CAF3F;
				}
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="explore"]:hover .icon-wrapper {
					border-color: #9CAF3F;
				}
			}

			/* Observe (Rose Pink) */
			.nav-item-link[data-category="observe"]:hover {
				background-color: color-mix(in srgb, #B55D82 12%, transparent);
				color: #B55D82;
			}
			.nav-item-link[data-category="observe"]:hover .icon-wrapper {
				border-color: #B55D82;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="observe"]:hover {
				background-color: color-mix(in srgb, #C27392 18%, transparent);
				color: #C27392;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="observe"]:hover .icon-wrapper {
				border-color: #C27392;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="observe"]:hover {
					background-color: color-mix(in srgb, #C27392 18%, transparent);
					color: #C27392;
				}
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="observe"]:hover .icon-wrapper {
					border-color: #C27392;
				}
			}

			/* About (Orange) */
			.nav-item-link[data-category="about"]:hover {
				background-color: color-mix(in srgb, #D65E1E 12%, transparent);
				color: #D65E1E;
			}
			.nav-item-link[data-category="about"]:hover .icon-wrapper {
				border-color: #D65E1E;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="about"]:hover {
				background-color: color-mix(in srgb, #E57335 18%, transparent);
				color: #E57335;
			}
			:global([data-theme="dark"]) .nav-item-link[data-category="about"]:hover .icon-wrapper {
				border-color: #E57335;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="about"]:hover {
					background-color: color-mix(in srgb, #E57335 18%, transparent);
					color: #E57335;
				}
				:global(:root:not([data-theme="light"])) .nav-item-link[data-category="about"]:hover .icon-wrapper {
					border-color: #E57335;
				}
			}

			/* Click/Press State (Both active and inactive) */
			.nav-item-link:active {
				transform: translate(2px, 2px);
				box-shadow: 1px 1px 0 var(--shadow-flat);
			}

			/* Active Link Styles (Flat by default for horizontal top bar alignment) */
			.nav-item-link.active {
				background-color: var(--accent);
				color: #FFFFFF;
				border-color: var(--border-color);
				transform: none;
				box-shadow: none;
			}
			.nav-item-link.active .icon-wrapper {
				background-color: rgba(255,255,255,0.2);
				border-color: #FFFFFF;
			}

			/* Active Link Hover State (Raises up, using filter to adjust brightness dynamically) */
			.nav-item-link.active:hover {
				background-color: var(--accent);
				filter: brightness(0.92);
				color: #FFFFFF;
				border-color: var(--border-color);
				transform: translate(-2px, -2px);
				box-shadow: 3px 3px 0 var(--shadow-flat);
			}
			:global([data-theme="dark"]) .nav-item-link.active:hover {
				filter: brightness(1.1);
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme="light"])) .nav-item-link.active:hover {
					filter: brightness(1.1);
				}
			}
			.nav-item-link.active:hover .icon-wrapper {
				background-color: rgba(255,255,255,0.25);
				border-color: #FFFFFF;
			}

			.icon-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 32px;
				border-radius: 8px;
				border: 2px solid var(--border-color);
				background-color: var(--bg-card);
				transition: background-color 0.2s ease-in-out;
			}

			.icon-wrapper :global(svg) {
				width: 16px;
				height: 16px;
			}

			.sidebar-bottom {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.sidebar-bottom-label {
				display: none; /* Hide label in top bar mode for compactness */
			}

			/* Main Content Area */
			.main-content {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 3rem 2rem;
				width: 100%;
				max-width: 1200px; /* Limit content width on desktop */
				margin: 0 auto;
			}

			/* Content Container */
			.content-card {
				background-color: var(--bg-canvas);
				border: 2px solid var(--border-color);
				border-radius: 32px;
				box-shadow: 5px 5px 0 var(--shadow-flat);
				padding: 3rem;
				flex: 1;
				transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
			}

			/* Tablet View Layout Adjustments */
			@media (max-width: 1024px) {
				.sidebar {
					padding: 1rem 2rem;
				}

				.sidebar-top {
					gap: 1.5rem;
				}

				.logo {
					font-size: 1.8rem;
				}

				.nav-item-link {
					padding: 0.5rem 1rem;
					font-size: 0.95rem;
					border-radius: 12px;
				}
			}

			/* Mobile View Layout Adjustments */
			@media (max-width: 768px) {
				.sidebar {
					flex-direction: column;
					align-items: flex-start;
					padding: 1.2rem 1.5rem;
					gap: 1.2rem;
					position: relative;
				}

				.sidebar-top {
					flex-direction: column;
					align-items: flex-start;
					gap: 1rem;
					width: 100%;
				}

				.nav-list {
					flex-wrap: wrap;
					gap: 0.5rem;
					width: 100%;
				}

				.sidebar-bottom {
					position: absolute;
					top: 1.2rem;
					right: 1.5rem;
				}

				.main-content {
					padding: 1.5rem 1rem;
				}

				.content-card {
					padding: 1.5rem;
					border-radius: 24px;
					box-shadow: 4px 4px 0 var(--shadow-flat);
				}
			}
		</style>
	</head>
	<body>
		<div class="app-container">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-top">
					<a href="/" class="logo">
						{SITE_TITLE}<span class="logo-dot">.</span>
					</a>
					<ul class="nav-list">
						{QUADRANTS_CONFIG.quadrants.map((quad) => (
							<li>
								<a 
									href={quad.url} 
									class={`nav-item-link ${activeCategory === quad.id ? 'active' : ''}`}
									data-category={quad.id}
								>
									<span class="icon-wrapper">
										<QuadrantIcon name={quad.icon} size={20} />
									</span>
									<span>{quad.title}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
				<div class="sidebar-bottom">
					<span class="sidebar-bottom-label">主题样式</span>
					<ThemeToggle />
				</div>
			</aside>

			<!-- Main Area -->
			<main class="main-content">
				<div class="content-card">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
