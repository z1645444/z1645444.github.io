---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeaderLink from '../components/HeaderLink.astro';
import QuadrantIcon from '../components/QuadrantIcon.astro';
import type { ImageMetadata } from 'astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_LOCALE,
	QUADRANTS_CONFIG,
	type QuadrantId,
	withBase,
} from '../consts';

interface Props {
	title?: string;
	description?: string;
	activeCategory?: QuadrantId;
	image?: ImageMetadata;
	pageType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	activeCategory = '',
	image,
	pageType = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;

// Find active quadrant configuration
const activeQuad = QUADRANTS_CONFIG.quadrants.find(
	(q) => q.id === activeCategory
);
const accentColorLight = activeQuad ? activeQuad.colorLight : '#3A828A';
const accentColorDark = activeQuad ? activeQuad.colorDark : '#4C9F9B';
---

<!doctype html>
<html lang={SITE_LOCALE}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={pageType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<!-- Dynamically override accent color variables based on category and theme -->
		<style define:vars={{ accentColorLight, accentColorDark }}>
			:root {
				--accent: var(--accentColorLight);
			}
			:root[data-theme='dark'] {
				--accent: var(--accentColorDark);
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme='light']) {
					--accent: var(--accentColorDark);
				}
			}
		</style>
		<style>
			/* Layout styling */
			.app-container {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				background-color: var(--bg-page);
				background-image: radial-gradient(
					var(--dot-color) 2.5px,
					transparent 2.5px
				);
				background-size: 28px 28px;
				transition: background-color 0.2s ease-in-out;
			}

			/* Sticky Top Navigation Bar (reusing sidebar class) */
			.sidebar {
				width: 100%;
				height: auto;
				background-color: var(--bg-sidebar);
				border-bottom: 1px solid var(--border-color);
				padding: 1.2rem 3rem;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				position: sticky;
				top: 0;
				z-index: 100;
				transition:
					background-color 0.2s ease-in-out,
					border-color 0.2s ease-in-out;
			}

			.sidebar-top {
				display: flex;
				flex-direction: row;
				align-items: center;
				gap: 3rem;
				flex: 1;
			}

			.logo {
				font-family: var(--font-atkinson);
				font-size: 2.2rem;
				font-weight: 900;
				letter-spacing: -1px;
				color: var(--text-main);
				text-decoration: none;
				display: inline-block;
				transition: color 0.15s ease-in-out;
			}

			.logo:hover {
				color: var(--accent);
			}

			.logo-dot {
				color: var(--accent);
				transition: color 0.3s ease;
			}

			/* Horizontal Navigation List */
			.nav-list {
				display: flex;
				flex-direction: row;
				gap: 0.8rem;
				list-style: none;
				padding: 0;
			}

			.nav-item-link {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.6rem 1.2rem;
				font-weight: 700;
				font-size: 1.05rem;
				color: var(--text-main);
				text-decoration: none;
				border: 1px solid transparent;
				border-radius: 16px;
				transition:
					background-color 0.15s ease,
					color 0.15s ease,
					transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}

			/* Inactive Link Default Hover Base (Raises up) */
			.nav-item-link:hover {
				border-color: var(--border-color);
				transform: translate(-2px, -2px);
				box-shadow: 3px 3px 0 var(--shadow-flat);
			}

			/* Navigation colors come from QUADRANTS_CONFIG through CSS variables. */
			.nav-item-link:hover {
				background-color: color-mix(
					in srgb,
					var(--nav-color-light) 12%,
					transparent
				);
				color: var(--nav-color-light);
			}

			.nav-item-link:hover .icon-wrapper {
				border-color: var(--nav-color-light);
			}

			:global([data-theme='dark']) .nav-item-link:hover {
				background-color: color-mix(
					in srgb,
					var(--nav-color-dark) 18%,
					transparent
				);
				color: var(--nav-color-dark);
			}

			:global([data-theme='dark']) .nav-item-link:hover .icon-wrapper {
				border-color: var(--nav-color-dark);
			}

			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme='light'])) .nav-item-link:hover {
					background-color: color-mix(
						in srgb,
						var(--nav-color-dark) 18%,
						transparent
					);
					color: var(--nav-color-dark);
				}

				:global(:root:not([data-theme='light']))
					.nav-item-link:hover
					.icon-wrapper {
					border-color: var(--nav-color-dark);
				}
			}

			/* Active Link Styles (Flat by default for horizontal top bar alignment) */
			.nav-item-link.active {
				background-color: var(--accent);
				color: #ffffff;
				border-color: var(--border-color);
				transform: none;
				box-shadow: none;
			}
			.nav-item-link.active .icon-wrapper {
				background-color: rgba(255, 255, 255, 0.2);
				border-color: #ffffff;
			}

			/* Active Link Hover State (Raises up, using filter to adjust brightness dynamically) */
			.nav-item-link.active:hover {
				background-color: var(--accent);
				filter: brightness(0.92);
				color: #ffffff;
				border-color: var(--border-color);
				transform: translate(-2px, -2px);
				box-shadow: 3px 3px 0 var(--shadow-flat);
			}
			:global([data-theme='dark']) .nav-item-link.active:hover {
				filter: brightness(1.1);
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not([data-theme='light'])) .nav-item-link.active:hover {
					filter: brightness(1.1);
				}
			}
			.nav-item-link.active:hover .icon-wrapper {
				background-color: rgba(255, 255, 255, 0.25);
				border-color: #ffffff;
			}

			.icon-wrapper {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 32px;
				border-radius: 8px;
				border: 1px solid var(--border-color);
				background-color: var(--bg-card);
				transition: background-color 0.2s ease-in-out;
			}

			.icon-wrapper :global(svg) {
				width: 16px;
				height: 16px;
			}

			.sidebar-bottom {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.sidebar-bottom-label {
				display: none; /* Hide label in top bar mode for compactness */
			}

			/* Main Content Area */
			.main-content {
				flex: 1;
				display: flex;
				flex-direction: column;
				padding: 3rem 2rem;
				width: 100%;
				max-width: 1200px; /* Limit content width on desktop */
				margin: 0 auto;
			}

			/* Content Container */
			.content-card {
				background-color: var(--bg-canvas);
				border: 1px solid var(--border-color);
				border-radius: 32px;
				box-shadow: 5px 5px 0 var(--shadow-flat);
				padding: 3rem;
				flex: 1;
				transition:
					background-color 0.2s ease-in-out,
					border-color 0.2s ease-in-out,
					box-shadow 0.2s ease-in-out;
			}

			/* Tablet View Layout Adjustments */
			@media (max-width: 1024px) {
				.sidebar {
					padding: 1rem 2rem;
				}

				.sidebar-top {
					gap: 1.5rem;
				}

				.logo {
					font-size: 1.8rem;
				}

				.nav-item-link {
					padding: 0.5rem 1rem;
					font-size: 0.95rem;
					border-radius: 12px;
				}
			}

			/* Mobile View Layout Adjustments */
			@media (max-width: 768px) {
				.sidebar {
					flex-direction: column;
					align-items: flex-start;
					padding: 1.2rem 1.5rem;
					gap: 1.2rem;
					position: relative;
				}

				.sidebar-top {
					flex-direction: column;
					align-items: center;
					gap: 1rem;
					width: 100%;
				}

				.nav-list {
					display: grid;
					grid-template-columns: repeat(2, 1fr);
					gap: 0.5rem;
					width: 100%;
				}

				.nav-list li {
					width: 100%;
				}

				.nav-list li .nav-item-link {
					width: 100%;
					justify-content: center;
				}

				.sidebar-bottom {
					position: absolute;
					top: 1.2rem;
					right: 1.5rem;
				}

				.main-content {
					padding: 1.5rem 1rem;
				}

				.content-card {
					padding: 1.5rem;
					border-radius: 24px;
					box-shadow: 4px 4px 0 var(--shadow-flat);
				}
			}
		</style>
	</head>
	<body>
		<div class="app-container">
			<!-- Sidebar -->
			<header class="sidebar">
				<div class="sidebar-top">
					<a href={withBase()} class="logo">
						{SITE_TITLE}<span class="logo-dot">.</span>
					</a>
					<nav aria-label="主要导航">
						<ul class="nav-list">
							{
								QUADRANTS_CONFIG.quadrants.map((quad) => (
									<li>
										<HeaderLink
											path={quad.path}
											active={activeCategory === quad.id}
											class="nav-item-link"
											data-category={quad.id}
											style={`--nav-color-light: ${quad.colorLight}; --nav-color-dark: ${quad.colorDark};`}
										>
											<span class="icon-wrapper">
												<QuadrantIcon name={quad.icon} size={20} />
											</span>
											<span>{quad.title}</span>
										</HeaderLink>
									</li>
								))
							}
						</ul>
					</nav>
				</div>
				<div class="sidebar-bottom">
					<span class="sidebar-bottom-label">主题样式</span>
					<ThemeToggle />
				</div>
			</header>

			<!-- Main Area -->
			<main class="main-content">
				<div class="content-card">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
