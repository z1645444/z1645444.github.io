---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../consts';

type LinkTarget =
	{ path: string; href?: never } | { href: string; path?: never };
type Props = LinkTarget &
	Omit<HTMLAttributes<'a'>, 'href'> & {
		active?: boolean;
	};

const { path, href, active = false, class: className, ...props } = Astro.props;
const resolvedHref = path ? withBase(path) : href;
---

<a
	href={resolvedHref}
	class:list={[className, { active }]}
	aria-current={active ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
