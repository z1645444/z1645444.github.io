---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ToyLayout from '../../layouts/ToyLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, QUADRANTS_CONFIG, withBase } from '../../consts';

export async function getStaticPaths() {
	// Generate paths for quadrants that point to category URLs
	const categories = QUADRANTS_CONFIG.quadrants
		.filter((q) => q.path.startsWith('category/'))
		.map((q) => q.id);

	return categories.map((cat) => ({
		params: { category: cat },
	}));
}

const { category } = Astro.params;

// Find quadrant config
const quad = QUADRANTS_CONFIG.quadrants.find((q) => q.id === category);
if (!quad) {
	throw new Error(`Category ${category} not found in configuration.`);
}

// Fetch and filter blog posts
const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => post.data.category === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

---

<ToyLayout 
	title={`${quad.title} - ${SITE_TITLE}`} 
	description={quad.description} 
	activeCategory={category}
>
	<div class="category-header">
		<div class="category-meta">
			<span class="category-badge">{quad.subtitle}</span>
			<span class="post-count-badge">{posts.length} POSTS</span>
		</div>
		<h1 class="category-title">{quad.title}</h1>
		<p class="category-desc">{quad.description}</p>
	</div>

	{posts.length === 0 ? (
		<div class="empty-state toy-card">
			<p>该分类下暂无文章，敬请期待！</p>
		</div>
	) : (
		<div class="posts-section">
			<div class="posts-grid">
				{posts.map((post, idx) => {
					const isLatest = idx === 0;
					return (
						<a 
							href={withBase(`blog/${post.id}/`)}
							class={`toy-card toy-card-interactive standard-card ${isLatest ? 'latest-card' : ''}`}
						>
							{isLatest && (
								<div class="latest-pin">
									<span>NEW</span>
								</div>
							)}
							{post.data.heroImage && (
								<div class="card-image-wrapper">
									<Image 
										width={360} 
										height={200} 
										src={post.data.heroImage} 
										alt={post.data.title}
										class="card-image"
									/>
								</div>
							)}
							<div class="card-content">
								<span class="post-meta-badge">{isLatest ? '最新发布' : quad.subtitle}</span>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="post-desc">{post.data.description}</p>
								<span class="read-more">阅读全文 →</span>
							</div>
						</a>
					);
				})}
			</div>
		</div>
	)}
</ToyLayout>

<style>
	/* Header styles */
	.category-header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 2px dashed var(--border-color);
	}

	.category-meta {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 0.8rem;
	}

	.category-badge {
		display: inline-block;
		padding: 0.3rem 0.8rem;
		background-color: var(--accent);
		color: #FFFFFF;
		border: 2px solid var(--border-color);
		border-radius: 10px;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: background-color 0.3s ease;
	}

	.post-count-badge {
		display: inline-block;
		padding: 0.3rem 0.8rem;
		background-color: var(--bg-sidebar);
		color: var(--text-muted);
		border: 2px dashed var(--border-color);
		border-radius: 10px;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.category-title {
		font-size: 3rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.8rem;
		letter-spacing: -1px;
	}

	.category-desc {
		font-size: 1.1rem;
		color: var(--text-muted);
		max-width: 700px;
		line-height: 1.6;
	}

	/* Empty state */
	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--text-muted);
	}

	/* Grid layout for posts */
	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	/* Standard Card styling */
	.standard-card {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 2rem;
		padding: 2rem;
		position: relative;
	}

	/* Latest Card Highlight */
	.latest-card {
		box-shadow: 4px 4px 0px var(--accent);
	}

	.latest-card:hover {
		box-shadow: 6px 6px 0px var(--accent);
	}


	.latest-pin {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background-color: var(--accent);
		color: #FFFFFF;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.2rem 0.6rem;
		border: 2px solid var(--border-color);
		border-radius: 8px;
		box-shadow: 2px 2px 0px var(--shadow-flat);
		z-index: 10;
		transform: rotate(3deg);
	}

	.card-image-wrapper {
		width: 100%;
		max-width: 360px;
		border-radius: 12px;
		overflow: hidden;
		border: 2px solid var(--border-color);
		margin-bottom: 0;
		aspect-ratio: 16 / 9;
		flex-shrink: 0;
	}

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border: none;
		border-radius: 0;
	}

	.standard-card .card-content {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	/* Inner card text styling */
	.post-meta-badge {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 0.4rem;
		display: inline-block;
		transition: color 0.3s ease;
	}

	.post-title {
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 0.4rem;
		line-height: 1.3;
	}

	.post-date {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.post-desc {
		font-size: 0.95rem;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.read-more {
		font-weight: 700;
		color: var(--accent);
		font-size: 0.95rem;
		align-self: flex-start;
		transition: transform 0.2s ease, color 0.3s ease;
	}

	.toy-card-interactive:hover .read-more {
		transform: translateX(4px);
		color: var(--accent-dark);
	}

	/* Responsive layouts */
	@media (max-width: 768px) {
		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.standard-card {
			flex-direction: column;
			align-items: stretch;
			gap: 1.2rem;
			padding: 1.5rem;
		}

		.card-image-wrapper {
			max-width: 100%;
		}

		.category-title {
			font-size: 2.2rem;
		}
	}
</style>
