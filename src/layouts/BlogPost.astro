---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ToyLayout from './ToyLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { QUADRANTS_CONFIG, type QuadrantId } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	category?: QuadrantId;
	activeCategory?: QuadrantId;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	activeCategory,
} = Astro.props;
const resolvedActiveCategory = activeCategory ?? category;

const quad = QUADRANTS_CONFIG.quadrants.find(
	(q) => q.id === resolvedActiveCategory
);
---

<ToyLayout
	title={title}
	description={description}
	activeCategory={resolvedActiveCategory}
	image={heroImage}
	pageType={pubDate ? 'article' : 'website'}
	publishedTime={pubDate}
	modifiedTime={updatedDate}
>
	<article class="post-article">
		{
			heroImage && (
				<div class="article-hero-wrapper">
					<Image
						width={960}
						height={480}
						src={heroImage}
						alt={title}
						class="article-hero-image"
					/>
				</div>
			)
		}

		<div class="article-meta">
			{
				quad && (
					<div class="article-category">
						<span class="category-badge">{quad.subtitle}</span>
					</div>
				)
			}
			{
				pubDate && (
					<div class="article-date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated">
								（已于 <FormattedDate date={updatedDate} /> 更新）
							</span>
						)}
					</div>
				)
			}
			<h1 class="article-title">{title}</h1>
			<p class="article-desc">{description}</p>
			<hr class="article-divider" />
		</div>

		<div class="prose">
			<slot />
		</div>
	</article>
</ToyLayout>

<style>
	.post-article {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.article-hero-wrapper {
		width: 100%;
		border-radius: 20px;
		overflow: hidden;
		border: 1px solid var(--border-color);
		aspect-ratio: 21 / 9;
	}

	.article-hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border: none;
		border-radius: 0;
	}

	.article-category {
		margin-bottom: 0.2rem;
	}

	.category-badge {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		background-color: var(--accent);
		color: #ffffff;
		border: 1px solid transparent;
		border-radius: 10px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.article-meta {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.article-date {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.last-updated {
		font-style: italic;
		color: var(--accent);
		margin-left: 0.5rem;
	}

	.article-title {
		font-size: 2.8rem;
		font-weight: 700;
		color: var(--text-main);
		line-height: 1.2;
		letter-spacing: -1px;
	}

	.article-desc {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.article-divider {
		border: none;
		border-top: 1px solid var(--border-color);
		margin: 1rem 0 0 0;
	}

	/* Style the rendered markdown content */
	.prose {
		color: var(--text-main);
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.prose :global(p) {
		margin-bottom: 1.5rem;
	}

	.prose :global(h2) {
		font-size: 1.8rem;
		font-weight: 700;
		margin: 2.5rem 0 1rem 0;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.3rem;
		display: inline-block;
	}

	.prose :global(h3) {
		font-size: 1.4rem;
		font-weight: 700;
		margin: 2rem 0 1rem 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 2rem;
	}

	.prose :global(li) {
		margin-bottom: 0.5rem;
	}

	.prose :global(a) {
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.prose :global(img) {
		margin: 2rem 0;
		box-shadow: 4px 4px 0px var(--shadow-flat);
	}

	@media (max-width: 768px) {
		.article-title {
			font-size: 2.2rem;
		}

		.article-hero-wrapper {
			aspect-ratio: 16 / 9;
		}
	}
</style>
